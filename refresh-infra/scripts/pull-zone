#!/bin/bash
# pull-zone — Pull live Cloudflare zone config for the current infra repo
#
# Reads zone and zone_id from cloudflare/zone.yaml, then pulls DNS records,
# custom rulesets, and email routing configuration from the Cloudflare API.
# Writes zone.yaml, rules.yaml, and email.yaml into cloudflare/.
#
# Usage:
#   pull-zone
#
# Requires: curl, jq, yq, CF_READ_ONLY_API_TOKEN env var

set -o errexit
set -o nounset
set -o pipefail

exec 3>&1 4>&2

# Constants
CF_API='https://api.cloudflare.com/client/v4'
CF_DIR='cloudflare'
ZONE_YAML="${CF_DIR}/zone.yaml"

# Zone settings tracked for drift. Deliberately a whitelist, not every setting:
# the full list is ~100 entries, most of them plan-derived and read-only, whose
# churn would bury real changes. Each name here is a valid {setting_id} for
# PATCH /zones/{zone_id}/settings/{setting_id}, so settings.yaml doubles as the
# apply intent — the file says exactly what to assert, in the API's own shape.
TRACKED_SETTINGS=(
  0rtt
  always_use_https
  automatic_https_rewrites
  browser_check
  email_obfuscation
  hotlink_protection
  min_tls_version
  security_header
  security_level
  server_side_exclude
  ssl
  tls_1_3
)

# Skip repos with no infrastructure
[[ -f "${ZONE_YAML}" ]] || {
  printf >&3 '▸ %s not found — no infrastructure, skipping\n' "${ZONE_YAML}"
  exit 0
}

ZONE="$(yq -r '.zone' "${ZONE_YAML}")"
ZONE_ID="$(yq -r '.zone_id' "${ZONE_YAML}")"

[[ "${ZONE_ID}" = 'ZONE_ID' ]] && {
  printf >&3 '▸ zone_id is a placeholder — skipping\n'
  exit 0
}

# Validate
[[ -z "${CF_READ_ONLY_API_TOKEN:-}" ]] && {
  printf >&4 '✗ CF_READ_ONLY_API_TOKEN not set\n'
  exit 1
}

printf >&3 '▸ Pulling config for %s (%s)\n' "${ZONE}" "${ZONE_ID}"

# --- Functions ---

# Preflight. cf-api below deliberately swallows errors so that an absent
# optional subresource (email routing, custom rulesets) reads as "none" rather
# than aborting. That tolerance is wrong for a credential failure: every
# endpoint then returns the empty fallback, pull-dns commits `records: []`, and
# the action raises a PR deleting the entire mirror. Prove the token can read
# the zone before any file is written.
verify-access() {
  local RESPONSE
  RESPONSE="$(cf-api "/zones/${ZONE_ID}")"

  [[ "$(jq -r '.success' <<<"${RESPONSE}")" = 'true' ]] || {
    printf >&4 '✗ cannot read zone %s (%s) — check CF_READ_ONLY_API_TOKEN\n' "${ZONE}" "${ZONE_ID}"
    exit 1
  }
}

cf-api() {
  local ENDPOINT="${1}"
  curl -sf \
    -H "Authorization: Bearer ${CF_READ_ONLY_API_TOKEN}" \
    -H 'Content-Type: application/json' \
    "${CF_API}${ENDPOINT}" \
    </dev/null 2>/dev/null ||
    echo '{"success":false,"result":[]}'
}

pull-dns() {
  local RESPONSE
  RESPONSE="$(cf-api "/zones/${ZONE_ID}/dns_records?per_page=500")"

  echo "${RESPONSE}" |
    jq --arg zone "${ZONE}" --arg zone_id "${ZONE_ID}" '{
        zone: $zone,
        zone_id: $zone_id,
        records: [
          .result
          | sort_by(
              ({"A":0,"AAAA":1,"CNAME":2,"MX":3,"TXT":4,"SRV":5,"NS":6,"CAA":7}[.type] // 99),
              .name,
              (.priority // 0),
              .content
            )[]
          | {
              type,
              name: (if .name == $zone then $zone
                     elif (.name | endswith("." + $zone)) then .name[:-($zone | length + 1)]
                     else .name end),
              content,
              proxied: (.proxied // false),
              ttl
            }
          + (if .priority != null then {priority: .priority} else {} end)
          + (if .comment != null and .comment != "" then {comment: .comment} else {} end)
        ]
      }' |
    yq -P '.' >"${CF_DIR}/zone.yaml"

  local RECORD_COUNT
  RECORD_COUNT="$(jq '.result | length' <<<"${RESPONSE}")"
  printf >&3 '  zone.yaml: %s records\n' "${RECORD_COUNT}"
}

pull-rules() {
  local RULESETS_RESPONSE
  RULESETS_RESPONSE="$(cf-api "/zones/${ZONE_ID}/rulesets")"

  local CUSTOM_IDS
  CUSTOM_IDS="$(echo "${RULESETS_RESPONSE}" |
    jq -r '.result[] | select(.kind == "zone") | .id')"

  [[ -z "${CUSTOM_IDS}" ]] && {
    [[ -f "${CF_DIR}/rules.yaml" ]] && rm -f "${CF_DIR}/rules.yaml"
    printf >&3 '  rules.yaml: none\n'
    return 0
  }

  local ALL_DETAILS='[]'
  while IFS= read -r RULESET_ID; do
    [[ -z "${RULESET_ID}" ]] && continue
    local DETAIL
    DETAIL="$(cf-api "/zones/${ZONE_ID}/rulesets/${RULESET_ID}")"
    ALL_DETAILS="$(echo "${ALL_DETAILS}" |
      jq --argjson detail "${DETAIL}" '. + [$detail.result]')"
  done <<<"${CUSTOM_IDS}"

  echo "${ALL_DETAILS}" |
    jq --arg zone "${ZONE}" --arg zone_id "${ZONE_ID}" '{
        zone: $zone,
        zone_id: $zone_id,
        rulesets: [
          .[]
          | select(. != null)
          | {
              id,
              phase,
              name,
              description: (.description // ""),
              rules: [
                (.rules // [])[]
                | {
                    id,
                    description: (.description // ""),
                    action,
                    enabled,
                    expression,
                    action_parameters: (.action_parameters // {})
                  }
              ]
            }
        ]
      }' |
    yq -P '.' >"${CF_DIR}/rules.yaml"

  local RULE_COUNT
  RULE_COUNT="$(jq '[.[].rules // [] | length] | add // 0' <<<"${ALL_DETAILS}")"
  printf >&3 '  rules.yaml: %s rules\n' "${RULE_COUNT}"
}

pull-email() {
  local SETTINGS_RESPONSE
  SETTINGS_RESPONSE="$(cf-api "/zones/${ZONE_ID}/email/routing")"

  local RULES_RESPONSE
  RULES_RESPONSE="$(cf-api "/zones/${ZONE_ID}/email/routing/rules")"

  local ENABLED
  ENABLED="$(echo "${SETTINGS_RESPONSE}" | jq -r '.result.enabled // false')"

  local RULE_COUNT
  RULE_COUNT="$(echo "${RULES_RESPONSE}" | jq '.result | length // 0')"

  [[ "${ENABLED}" = 'false' ]] && ((RULE_COUNT == 0)) && {
    [[ -f "${CF_DIR}/email.yaml" ]] && rm -f "${CF_DIR}/email.yaml"
    printf >&3 '  email.yaml: none\n'
    return 0
  }

  jq -n \
    --arg zone "${ZONE}" \
    --arg zone_id "${ZONE_ID}" \
    --argjson settings "${SETTINGS_RESPONSE}" \
    --argjson rules "${RULES_RESPONSE}" \
    '{
      zone: $zone,
      zone_id: $zone_id,
      email_routing: {
        enabled: ($settings.result.enabled // false),
        status: ($settings.result.status // "unknown"),
        subdomains: [
          ($settings.result.subdomains // [])[]
          | {
              name,
              enabled,
              status
            }
        ],
        rules: [
          ($rules.result // [])[]
          | {
              enabled,
              name: (.name // ""),
              matchers: .matchers,
              actions: .actions
            }
        ]
      }
    }' |
    yq -P '.' >"${CF_DIR}/email.yaml"

  printf >&3 '  email.yaml: %s rules\n' "${RULE_COUNT}"
}

pull-settings() {
  local RESPONSE
  RESPONSE="$(cf-api "/zones/${ZONE_ID}/settings")"

  local TRACKED
  TRACKED="$(printf '%s\n' "${TRACKED_SETTINGS[@]}" | jq -Rsc 'split("\n") - [""]')"

  local SETTING_COUNT
  SETTING_COUNT="$(jq --argjson tracked "${TRACKED}" \
    '[.result[]? | select(.id as $i | $tracked | index($i))] | length' <<<"${RESPONSE}")"

  # Every zone has settings, so an empty result is an API failure, never a real
  # state. Writing it would emit a drift PR that deletes the whole file.
  ((SETTING_COUNT == 0)) && {
    printf >&4 '  ✗ settings.yaml: no settings returned — keeping committed file\n'
    return 0
  }

  # yq quotes exactly the scalars that would otherwise be misread — "1.3" as a
  # float, "on"/"off" as YAML 1.1 booleans — and leaves the rest bare, matching
  # the sibling zone/rules/email files byte for byte in style.
  jq --arg zone "${ZONE}" --arg zone_id "${ZONE_ID}" --argjson tracked "${TRACKED}" '{
      zone: $zone,
      zone_id: $zone_id,
      settings: [
        .result[]
        | select(.id as $i | $tracked | index($i))
        | {key: .id, value: .value}
      ] | sort_by(.key) | from_entries
    }' <<<"${RESPONSE}" |
    yq -P '.' >"${CF_DIR}/settings.yaml"

  printf >&3 '  settings.yaml: %s settings\n' "${SETTING_COUNT}"
}

# Zone security state that is NOT a DNS record and NOT a zone setting, so none
# of the pulls above would notice it changing. Each of these was asserted
# fleet-wide and was, until now, watched by nothing:
#
#   dnssec           — status plus the DS the registrar must publish. "pending"
#                      means enabled in Cloudflare but never completed at the
#                      registrar, which looks configured and protects nothing.
#   certificate_packs — 11 duplicate packs were deleted on 2026-08-08, each
#                      renewing independently and multiplying CT-log alerts.
#                      Nothing recorded they had existed.
#   security_txt     — Cloudflare-managed, not a file in the site repo, so it is
#                      invisible to both this mirror and the www.* repos.
#
# Written to one file rather than three: they share a cause (zone-level security
# state outside DNS) and a reviewer reads them together.
pull-security() {
  local DNSSEC PACKS SECTXT

  DNSSEC="$(cf-api "/zones/${ZONE_ID}/dnssec")"
  PACKS="$(cf-api "/zones/${ZONE_ID}/ssl/certificate_packs?per_page=50")"
  SECTXT="$(cf-api "/zones/${ZONE_ID}/security-center/securitytxt")"

  # Unlike settings, these endpoints can legitimately be unavailable — a token
  # may lack the scope. Distinguish "read it, it is empty" from "could not read
  # it": only the former should overwrite a committed file.
  [[ "$(jq -r '.success' <<<"${DNSSEC}")" = 'true' ]] || {
    printf >&4 '  ✗ security.yaml: dnssec unreadable — keeping committed file\n'
    return 0
  }

  jq -n \
    --arg zone "${ZONE}" \
    --arg zone_id "${ZONE_ID}" \
    --argjson dnssec "${DNSSEC}" \
    --argjson packs "${PACKS}" \
    --argjson sectxt "${SECTXT}" \
    '{
      zone: $zone,
      zone_id: $zone_id,
      dnssec: {
        status: ($dnssec.result.status // "unknown"),
        algorithm: ($dnssec.result.algorithm // null),
        digest_type: ($dnssec.result.digest_type // null),
        key_tag: ($dnssec.result.key_tag // null),
        ds: ($dnssec.result.ds // null)
      },
      certificate_packs: [
        ($packs.result // [])[]
        | {
            type,
            status,
            certificate_authority: (.certificate_authority // null),
            validity_days: (.validity_days // null),
            hosts: ((.hosts // []) | sort)
          }
      ] | sort_by(.type, (.hosts | join(","))),
      security_txt: {
        enabled: ($sectxt.result.enabled // false),
        contact: ($sectxt.result.contact // []),
        expires: ($sectxt.result.expires // null)
      }
    }' |
    yq -P '.' >"${CF_DIR}/security.yaml"

  printf >&3 '  security.yaml: dnssec=%s packs=%s\n' \
    "$(jq -r '.result.status // "?"' <<<"${DNSSEC}")" \
    "$(jq -r '(.result // []) | length' <<<"${PACKS}")"
}

# --- Main ---

verify-access
pull-dns
pull-rules
pull-email
pull-settings
pull-security

printf >&3 '  ✓ done\n'

exit 0
